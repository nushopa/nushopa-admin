{
  "name": "Nushopa-admin",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:production": "npm run build && npm run test:e2e",
    "validate": "npm run lint && npm run test:unit && npm run test:production",
    "prepare": "husky"
  },
  "dependencies": {
    "@heroicons/react": "^2.1.1",
    "@lexical/code": "^0.21.0",
    "@lexical/html": "^0.21.0",
    "@lexical/link": "^0.21.0",
    "@lexical/list": "^0.21.0",
    "@lexical/react": "^0.21.0",
    "@lexical/rich-text": "^0.21.0",
    "@lexical/selection": "^0.21.0",
    "@lexical/utils": "^0.21.0",
    "@material-tailwind/react": "^2.1.9",
    "@reduxjs/toolkit": "^2.0.1",
    "apexcharts": "^4.1.0",
    "axios": "^1.6.5",
    "date-fns": "^4.1.0",
    "firebase": "^10.10.0",
    "js-cookie": "^3.0.5",
    "lexical": "^0.21.0",
    "phantom-request": "^1.5.0",
    "react": "^18.2.0",
    "react-apexcharts": "^1.7.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.6.0",
    "react-redux": "^9.0.4",
    "react-router-dom": "^6.21.1",
    "react-toastify": "^10.0.4",
    "redux-persist": "^6.0.0",
    "socket.io-client": "^4.7.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^16.4.0",
    "postcss": "^8.4.33",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.1",
    "vite": "^5.0.8",
    "vitest": "^2.1.9"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
